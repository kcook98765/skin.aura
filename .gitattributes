# Detect text automatically; use LF without treating binary payloads as text.
* text=auto eol=lf

# Binary assets must not undergo text conversion, diffing or merging.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.bmp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
*.wav binary
*.mp3 binary
*.ogg binary
*.flac binary
*.xbt binary

# Source development files stay in Git but need not enter git archive payloads.
# This does not define an installable package; see docs/PACKAGING.md.
/docs export-ignore
/docs/** export-ignore
/tools export-ignore
/tools/** export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.project export-ignore
