<?xml version="1.0" encoding="UTF-8"?>
<!-- Foundation -->
<includes>

    <include file="Defaults.xml" />

    <include file="Includes_Animations.xml" />
    <include file="Includes_Defs.xml" />
    <include file="Includes_Dialog.xml" />
    <include file="Includes_Global.xml" />
    <include file="Includes_Items.xml" />
    <include file="Includes_Images.xml" />
    <include file="Includes_Labels.xml" />
    <include file="Includes_Object.xml" />
    <include file="Includes_OSD.xml" />
    <include file="Includes_Statusbar.xml" />
    <include file="Includes_Topbar.xml" />
    <include file="Includes_VideoLyrics.xml" />
    <include file="Includes_Weather.xml" />
    <include file="Includes_Widgets.xml" />

    <include file="Includes_View.xml" />
    <include file="Includes_View_List.xml" />
    <include file="Includes_View_Posters.xml" />
    <include file="Includes_PVR_Omega.xml" />

    <include file="script-skinshortcuts-includes.xml"/>

    <include file="Constants_Main.xml" />
    <include condition="Skin.HasSetting(MouseMode)" file="Constants_Home_Mouse.xml" />
    <include condition="!Skin.HasSetting(MouseMode) + Skin.HasSetting(DisableCategoriesWidgetLabel)" file="Constants_Home_NoMouse.xml" />
    <include condition="!Skin.HasSetting(MouseMode) + !Skin.HasSetting(DisableCategoriesWidgetLabel)" file="Constants_Home_NoMouse_BigSubmenu.xml" />

    <variable name="ColorHighlight">
        <value condition="!String.IsEmpty(Skin.String(focuscolor.name))">$INFO[Skin.String(focuscolor.name)]</value>
        <value>Highlight</value>
    </variable>
    <variable name="ColorHighlight2">
        <value condition="!String.IsEmpty(Skin.String(gradientcolor.name))">$INFO[Skin.String(gradientcolor.name)]</value>
        <value>GradientHighlight</value>
    </variable>

    <variable name="ColorOverlay">
        <value condition="Skin.HasSetting(DisableOverlayColor)">FFffffff</value>
        <value condition="!String.IsEmpty(Skin.String(overlaycolor.name))">$INFO[Skin.String(overlaycolor.name)]</value>
        <value>Overlay</value>
    </variable>

    <include name="Dimensions_Fullscreen">
        <left>0</left>
        <top>0</top>
        <width>1920</width>
        <height>1080</height>
    </include>

    <!-- Library monitoring is local. Online work requires explicit opt-in. Never
         set broad SkinInfo.Service, which would enable both provider groups. -->
    <include name="Aura_Services_OnLoad">
        <onload>Skin.Reset(SkinInfo.Service)</onload>
        <onload>Skin.SetBool(SkinInfo.Service.Library)</onload>
        <onload condition="Skin.HasSetting(Aura.OnlineEnrichment)">Skin.SetBool(SkinInfo.Service.Online)</onload>
        <onload condition="!Skin.HasSetting(Aura.OnlineEnrichment)">Skin.Reset(SkinInfo.Service.Online)</onload>
        <onload condition="Skin.HasSetting(Aura.OnlineEnrichment)">Skin.SetBool(TMDbHelper.Service)</onload>
        <onload condition="!Skin.HasSetting(Aura.OnlineEnrichment)">Skin.Reset(TMDbHelper.Service)</onload>
        <onload>SetProperty(SkinInfo.BlurSourceVar,Aura_BlurImage,Home)</onload>
        <onload>SetProperty(SkinInfo.BlurPrefix,Aura,Home)</onload>
        <onload condition="String.IsEmpty(Skin.String(SkinInfo.BlurRadius)) + !String.IsEmpty(Skin.String(colorbox_blursize))">Skin.SetString(SkinInfo.BlurRadius,$INFO[Skin.String(colorbox_blursize)])</onload>
        <onload condition="Skin.HasSetting(EnableBlur)">Skin.SetBool(SkinInfo.Blur)</onload>
        <onload condition="!Skin.HasSetting(EnableBlur)">Skin.Reset(SkinInfo.Blur)</onload>
    </include>
</includes>
