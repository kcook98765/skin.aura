<?xml version="1.0" encoding="UTF-8"?>
<!-- Foundation -->
<window id="2001">
    <defaultcontrol always="true">300</defaultcontrol>
    <include content="Object_Aura_InfoBlur_OnLoad">
        <param name="window" value="musicinformation" />
    </include>
    <controls>
        <include>Object_Aura_BlurSource</include>
        
        <control type="list" id="300">
            <top>30</top>
            <onup condition="Skin.HasSetting(EnablePressingUp)">9601</onup>
            <ondown>9601</ondown>
            <include>Topbar_Menu_Layout</include>
            <include>Items_Info</include>
        </control>
        <include>Topbar_Info</include>
        

        <control type="group">
            <visible allowhiddenfocus="true">!$EXP[Exp_HideFurniture]</visible>
            <include>Object_UpDownInfoArrows</include>
            <include>Animation_FadeInOut</include>
            <control type="group">
                <include>Animation_Right_Delay</include>

                <control type="scrollbar" id="9560">
                    <top>0</top>
                    <right>0</right>
                    <width>8</width>
                    <bottom>0</bottom>
                    <showonepage>false</showonepage>
                    <orientation>vertical</orientation>
                    <texturesliderbackground colordiffuse="main_fg_12">common/white.png</texturesliderbackground>
                    <texturesliderbar colordiffuse="main_fg_30">common/white.png</texturesliderbar>
                    <texturesliderbarfocus colordiffuse="$VAR[ColorHighlight]">common/white.png</texturesliderbarfocus>
                    <animation effect="fade" start="100" end="33" time="400" condition="!Control.HasFocus(9560) + !Container.Scrolling">Conditional</animation>
                    <include>Animation_FadeIn</include>
                    <include>Animation_FadeOut</include>
                </control>

                <control type="grouplist" id="9000">
                    <pagecontrol>9560</pagecontrol>
                    <top>90</top>
                    <bottom>110</bottom>
                    <itemgap>0</itemgap>
                    <usecontrolcoords>true</usecontrolcoords>
                    <orientation>vertical</orientation>
                    <visible>!Window.IsVisible(script-script.extendedinfo-DialogVideoInfo.xml) + !Window.IsVisible(script-script.extendedinfo-DialogInfo.xml)</visible>
                    <control type="group">
                        <top>30</top>
                        <height>380</height>
                        <left>view_pad</left>
                        <right>view_pad</right>
                        <control type="group">
                            <left>0</left>
                            <width>360</width>
                            <height>360</height>
                            <control type="group">
                                <left>-10</left>
                                <right>-10</right>
                                <bottom>-10</bottom>
                                <top>-10</top>
                                <include>Defs_PosterBack</include>
                                <control type="image">
                                    <bordersize>10</bordersize>
                                    <aspectratio scalediffuse="false">scale</aspectratio>
                                    <texture diffuse="diffuse/widgetposter.png" fallback="DefaultAddonImages.png">$VAR[Image_Poster]</texture>
                                </control>
                                <control type="image">
                                    <bordersize>10</bordersize>
                                    <texture colordiffuse="PixelLines" border="20">common/outline.png</texture>
                                </control>
                            </control>
                        </control>
                        <control type="group">
                            <left>390</left>
                            <height>360</height>
                            <include content="Object_Info">
                                <param name="id" value="50" />
                                <param name="width" value="1654" />
                                <param name="discart" value="true" />
                                <param name="hdsd_flag" value="true" />
                                <param name="visible" value="true" />
                                <param name="plot_height" value="170" />
                            </include>
                        </control>
                    </control>

                    <control type="group" description="Native music dates">
                        <left>view_pad</left>
                        <right>view_pad</right>
                        <height>48</height>
                        <visible>$EXP[Aura.MusicContextAction] + [!String.IsEmpty(ListItem.ReleaseDate) | !String.IsEmpty(ListItem.OriginalDate)]</visible>
                        <control type="label">
                            <right>0</right>
                            <height>48</height>
                            <font>font_tiny</font>
                            <textcolor>main_fg_70</textcolor>
                            <scroll>true</scroll>
                            <label>$VAR[Aura_MusicReleaseDate]$VAR[Aura_MusicOriginalDate,   ,]</label>
                        </control>
                    </control>

                    <!-- Core binds the rows and handles Select/mouse itself.
                         No content, sorting, filtering or replacement click action:
                         SongInfo indexes its contributor vector by this row index. -->
                    <control type="group" description="Native music context">
                        <left>view_pad</left>
                        <right>view_pad</right>
                        <height>170</height>
                        <visible>$EXP[Aura.MusicRows]</visible>
                        <control type="label">
                            <top>10</top>
                            <right>0</right>
                            <height>40</height>
                            <textcolor>main_fg_100</textcolor>
                            <label>$VAR[Aura_MusicContext]</label>
                        </control>
                        <control type="list" id="50">
                            <top>55</top>
                            <right>0</right>
                            <height>100</height>
                            <orientation>horizontal</orientation>
                            <scrolltime>200</scrolltime>
                            <visible>$EXP[Aura.MusicRows]</visible>
                            <onup>300</onup>
                            <ondown>9503</ondown>
                            <onback>300</onback>
                            <itemlayout width="420" height="96">
                                <control type="label">
                                    <left>16</left>
                                    <top>8</top>
                                    <width>388</width>
                                    <height>40</height>
                                    <textcolor>main_fg_100</textcolor>
                                    <label>$INFO[ListItem.Label]</label>
                                </control>
                                <control type="label">
                                    <left>16</left>
                                    <top>48</top>
                                    <width>388</width>
                                    <height>32</height>
                                    <font>font_tiny</font>
                                    <textcolor>main_fg_70</textcolor>
                                    <label>$VAR[Aura_MusicRowDetail]</label>
                                </control>
                            </itemlayout>
                            <focusedlayout width="420" height="96">
                                <control type="image">
                                    <width>416</width>
                                    <height>88</height>
                                    <texture border="8" colordiffuse="$VAR[ColorHighlight]">common/box.png</texture>
                                    <visible>Control.HasFocus(50)</visible>
                                </control>
                                <control type="label">
                                    <left>16</left>
                                    <top>8</top>
                                    <width>388</width>
                                    <height>40</height>
                                    <textcolor>main_fg_100</textcolor>
                                    <scroll>true</scroll>
                                    <label>$INFO[ListItem.Label]</label>
                                </control>
                                <control type="label">
                                    <left>16</left>
                                    <top>48</top>
                                    <width>388</width>
                                    <height>32</height>
                                    <font>font_tiny</font>
                                    <textcolor>main_fg_70</textcolor>
                                    <scroll>true</scroll>
                                    <label>$VAR[Aura_MusicRowDetail]</label>
                                </control>
                            </focusedlayout>
                        </control>
                    </control>

                    <control type="group">
                        <top>15</top>
                        <height>455</height>
                        <left>view_pad</left>
                        <right>view_pad</right>
                        <control type="button" id="9503">
                            <onup condition="Control.IsVisible(50)">50</onup>
                            <onup condition="!Control.IsVisible(50)">300</onup>
                            <ondown>SetFocus(300)</ondown>
                            <texturefocus />
                            <texturenofocus />
                        </control>
                        <!-- Info Label -->
                        <control type="grouplist">
                            <top>20</top>
                            <height>42</height>
                            <left>0</left>
                            <align>left</align>
                            <itemgap>12</itemgap>
                            <usecontrolcoords>true</usecontrolcoords>
                            <orientation>horizontal</orientation>
                            <include>Object_DownArrows</include>
                            <control type="label">
                                <font>font_small</font>
                                <textcolor>main_fg_100</textcolor>
                                <aligny>center</aligny>
                                <width>auto</width>
                                <height>100%</height>
                                <label>$LOCALIZE[19033]</label>
                            </control>
                        </control>
                        <control type="grouplist">
                            <top>90</top>
                            <right>390</right>
                            <orientation>vertical</orientation>
                            <itemgap>9</itemgap>
                            <usecontrolcoords>true</usecontrolcoords>
                            <include content="Object_VideoInfo_InfoSection">
                                <param name="label" value="$LOCALIZE[561]" />
                                <param name="label2" value="ListItem.FileName" />
                            </include>
                            <include content="Object_VideoInfo_InfoSection">
                                <param name="label" value="$LOCALIZE[573]" />
                                <param name="label2" value="ListItem.Path" />
                                <param name="haspath" value="true" />
                            </include>
                            <include content="Object_VideoInfo_InfoSection">
                                <param name="label" value="$LOCALIZE[21893]" />
                                <param name="label2" value="ListItem.Property(Artist_Born)" />
                            </include>
                            <include content="Object_VideoInfo_InfoSection">
                                <param name="label" value="$LOCALIZE[21897]" />
                                <param name="label2" value="ListItem.Property(Artist_Died)" />
                            </include>
                            <include content="Object_VideoInfo_InfoSection">
                                <param name="label" value="$LOCALIZE[21894]" />
                                <param name="label2" value="ListItem.Property(Artist_Formed)" />
                            </include>
                            <include content="Object_VideoInfo_InfoSection">
                                <param name="label" value="$LOCALIZE[21896]" />
                                <param name="label2" value="ListItem.Property(Artist_Disbanded)" />
                            </include>
                            <include content="Object_VideoInfo_InfoSection">
                                <param name="label" value="$LOCALIZE[31354]" />
                                <param name="label2" value="ListItem.Property(Artist_Instrument)" />
                            </include>
                            <include content="Object_VideoInfo_InfoSection">
                                <param name="label" value="$LOCALIZE[31355]" />
                                <param name="label2" value="ListItem.Property(Artist_Mood)" />
                            </include>
                            <include content="Object_VideoInfo_InfoSection">
                                <param name="label" value="$LOCALIZE[736]" />
                                <param name="label2" value="ListItem.Property(Artist_Style)" />
                            </include>
                            <include content="Object_VideoInfo_InfoSection">
                                <param name="label" value="$LOCALIZE[31355]" />
                                <param name="label2" value="ListItem.Property(Album_Mood)" />
                            </include>
                            <include content="Object_VideoInfo_InfoSection">
                                <param name="label" value="$LOCALIZE[736]" />
                                <param name="label2" value="ListItem.Property(Album_Style)" />
                            </include>
                            <include content="Object_VideoInfo_InfoSection">
                                <param name="label" value="$LOCALIZE[15111]" />
                                <param name="label2" value="ListItem.Property(Album_Theme)" />
                            </include>
                            <include content="Object_VideoInfo_InfoSection">
                                <param name="label" value="$LOCALIZE[467]" />
                                <param name="label2" value="ListItem.Property(Album_Type)" />
                            </include>
                            <include content="Object_VideoInfo_InfoSection">
                                <param name="label" value="$LOCALIZE[21899]" />
                                <param name="label2" value="ListItem.Property(Album_Label)" />
                            </include>
                        </control>
                        <control type="image">
                            <top>60</top>
                            <right>0</right>
                            <width>360</width>
                            <height>360</height>
                            <aspectratio>keep</aspectratio>
                            <texture background="true">$VAR[Image_DiscArt]</texture>
                            <visible>$EXP[Aura.MusicDiscArt]</visible>
                        </control>
                        <control type="image">
                            <top>60</top>
                            <right>0</right>
                            <width>360</width>
                            <height>360</height>
                            <aspectratio>keep</aspectratio>
                            <texture background="true">$VAR[Image_ClearLogo]</texture>
                            <visible>!$EXP[Aura.MusicDiscArt]</visible>
                        </control>
                    </control>
                </control>

                <!-- Flags -->
                <control type="group">
                    <bottom>view_pad</bottom>
                    <height>40</height>
                    <left>view_pad</left>
                    <right>view_pad</right>
                    <control type="group">
                        <include content="Object_Flags">
                            <param name="container" value="" />
                            <param name="directory" value="color" />
                            <param name="align" value="left" />
                        </include>
                    </control>
                    <!-- Info -->
                    <control type="grouplist">
                        <align>right</align>
                        <right>0</right>
                        <height>40</height>
                        <itemgap>50</itemgap>
                        <orientation>horizontal</orientation>
                        <control type="label">
                            <height>40</height>
                            <font>font_small</font>
                            <textcolor>main_fg_100</textcolor>
                            <aligny>center</aligny>
                            <width max="1200">auto</width>
                            <label>$INFO[ListItem.Director,[COLOR=main_fg_30]$LOCALIZE[20339]   [/COLOR],]</label>
                            <visible>!String.IsEmpty(ListItem.Director)</visible>
                        </control>
                    </control>
                </control>
            </control>
        </control>

        <control type="group">
            <visible>!Window.IsVisible(script-script.extendedinfo-DialogVideoInfo.xml) + !Window.IsVisible(script-script.extendedinfo-DialogInfo.xml)</visible>
            <include>Object_PlotOverlay</include>
        </control>

        <!-- Hidden Buttons -->
        <control type="button" id ="9003">
            <description>Youtube</description>
            <label>31141</label>
            <onclick>Close</onclick>
            <onclick>ActivateWindow(videos,plugin://plugin.video.youtube/search/?q=$INFO[ListItem.Artist],return)</onclick>
            <onclick>SetFocus(50)</onclick>
            <include>Defs_Hidden_Button</include>
        </control>

        <control type="button" id ="6">
            <description>Refresh</description>
            <label>184</label>
            <include>Defs_Hidden_Button</include>
        </control>

        <control type="button" id ="7">
            <description>Rating</description>
            <label>$LOCALIZE[563]</label>
            <include>Defs_Hidden_Button</include>
        </control>

        <control type="button" id="8">
            <description>Native local album or song playback</description>
            <label>208</label>
            <enable>$EXP[Aura.MusicPlayable]</enable>
            <include>Defs_Hidden_Button</include>
        </control>

        <control type="button" id ="10">
            <description>Get Thumb</description>
            <label>13405</label>
            <include>Defs_Hidden_Button</include>
        </control>

        <control type="button" id ="12">
            <description>Native Artist Info on album; Album Info on song</description>
            <!-- Core sets 21891 for albums, 10523 for songs and enables song
                 Album Info only when its album ID is positive. No XML enable
                 condition: retain that native enable/disable decision. -->
            <label>21891</label>
            <include>Defs_Hidden_Button</include>
        </control>

        <control type="button" id="9001">
            <label>$LOCALIZE[31389]</label>
            <onclick condition="System.AddonIsEnabled(script.skin.info.service) + Skin.HasSetting(Aura.OnlineEnrichment) + Integer.IsGreater(ListItem.DBID,0) + [String.IsEqual(ListItem.DBType,artist) | String.IsEqual(ListItem.DBType,album)]">RunScript(script.skin.info.service,action=review_artwork,dbtype=$INFO[ListItem.DBType],dbid=$INFO[ListItem.DBID])</onclick>
            <description>Get Artwork</description>
            <include>Defs_Hidden_Button</include>
            <visible>Skin.HasSetting(Aura.OnlineEnrichment) + Integer.IsGreater(ListItem.DBID,0) + [String.IsEqual(ListItem.DBType,album) | String.IsEqual(ListItem.DBType,artist)] + System.AddonIsEnabled(script.skin.info.service)</visible>
        </control>
        <control type="button" id="9011">
            <label>$LOCALIZE[31388]</label>
            <onclick condition="System.AddonIsEnabled(script.skin.info.service) + Skin.HasSetting(Aura.OnlineEnrichment) + Integer.IsGreater(ListItem.DBID,0) + [String.IsEqual(ListItem.DBType,artist) | String.IsEqual(ListItem.DBType,album)]">RunScript(script.skin.info.service,action=download_artwork,dbtype=$INFO[ListItem.DBType],dbid=$INFO[ListItem.DBID])</onclick>
            <description>Get Artwork</description>
            <include>Defs_Hidden_Button</include>
            <visible>Skin.HasSetting(Aura.OnlineEnrichment) + Integer.IsGreater(ListItem.DBID,0) + [String.IsEqual(ListItem.DBType,album) | String.IsEqual(ListItem.DBType,artist)] + System.AddonIsEnabled(script.skin.info.service)</visible>
        </control>

    </controls>

</window>
