<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">9315</defaultcontrol>
    <onload>SetProperty(SkinInitStarted,1,home)</onload>
    <onload>ClearProperty(SkinSplashStarted,home)</onload>
    <include>Aura_Services_OnLoad</include>
<!--
    <onload condition="String.IsEmpty(Window(home).Property(SkinInitStarted)) + !String.IsEmpty(Skin.String(StartupPlaylist))">PlayMedia($ESCINFO[Skin.String(StartupPlaylist)])</onload>
    <onload condition="!Player.HasVideo + !String.IsEmpty(Skin.String(StartupPlaylist))">ReplaceWindow($INFO[System.StartupWindow])</onload>
    <onload condition="String.IsEmpty(Skin.String(StartupPlaylist))">ReplaceWindow($INFO[System.StartupWindow])</onload>

-->

    <controls>
        <control type="button" id="9315">
            <visible allowhiddenfocus="true">false</visible>
            <onfocus condition="String.IsEmpty(Window(home).Property(SkinInitStarted)) + !String.IsEmpty(Skin.String(StartupPlaylist))">PlayMedia($ESCINFO[Skin.String(StartupPlaylist)])</onfocus>
            <onfocus condition="!Player.HasVideo + !String.IsEmpty(Skin.String(StartupPlaylist))">ReplaceWindow($INFO[System.StartupWindow])</onfocus>
            <onfocus condition="String.IsEmpty(Skin.String(StartupPlaylist))">AlarmClock(GoHome,ReplaceWindow($INFO[System.StartupWindow]),00:03,silent,false)</onfocus>
        </control>
    </controls>
</window>
