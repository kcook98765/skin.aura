<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <!-- PVR-only layouts, registered once in Includes.xml.
         Kodi 21.3: PVRBase reserves 10 (show mode), 11 (groups), 28 (group
         button), 29/30 (headings); GUIMediaWindow reserves 12 (item count).
         Both windows use view 50; 60 is its scrollbar. Skin furniture uses
         9300..9312; the info dialog separately uses 9000 and 9400/9401.
         Source: xbmc/xbmc 21.3-Omega, GUIWindowPVRBase.h/.cpp,
         GUIWindowPVRGuide.cpp, GUIWindowPVRChannels.cpp and PVRBuiltins.cpp. -->

    <!-- Use the window's ListItem: GUIWindowPVRGuide::GetCurrentListItem returns
         the selected EVENT. Container(50).ListItem returns the CHANNEL instead
         (GUIEPGGridContainer::GetListItem), which would show its airing-now data
         even while browsing a future programme. Channels use their native item. -->
    <variable name="PVR_Omega_SummaryArt">
        <value condition="!String.IsEmpty(ListItem.EpgEventIcon)">$INFO[ListItem.EpgEventIcon]</value>
        <value>$INFO[ListItem.Icon]</value>
    </variable>
    <variable name="PVR_Omega_SummaryTitle">
        <value condition="!String.IsEmpty(ListItem.EpgEventTitle)">$INFO[ListItem.EpgEventTitle]</value>
        <value condition="!String.IsEmpty(ListItem.ChannelName)">$INFO[ListItem.ChannelName]</value>
        <value>$LOCALIZE[19055]</value>
    </variable>
    <variable name="PVR_Omega_DialogTitle">
        <value condition="!String.IsEmpty(ListItem.EpgEventTitle)">$INFO[ListItem.EpgEventTitle]</value>
        <value condition="!String.IsEmpty(ListItem.Title)">$INFO[ListItem.Title]</value>
        <value condition="!String.IsEmpty(ListItem.Label)">$INFO[ListItem.Label]</value>
        <value>$LOCALIZE[19055]</value>
    </variable>

